# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Llave pública: "anon" o la nueva "publishable" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Llave privada del servidor: "service_role" o la nueva "secret" (sb_secret_...). NUNCA en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Cadena de conexión a Postgres (Project Settings → Database → Connection string, "Session pooler").
# Solo se usa para correr migraciones con `npm run db:migrate`.
DATABASE_URL=

# URL pública de la app (para generar los enlaces de invitación)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secreto de un solo uso para crear el primer administrador (POST /api/setup)
SETUP_SECRET=cambia-esto-por-algo-largo

# Meta Ads. Pixel del Reto (se carga en las páginas públicas de registro) y token de la
# API de conversiones (Administrador de eventos → Configuración → API de conversiones → Generar token).
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# Opcional: código de "Probar eventos" del Administrador de eventos, para ver los envíos del servidor en vivo.
META_TEST_EVENT_CODE=

# Asistente de IA (Claude). Llave de https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Opcional: modelo del asistente (por defecto claude-opus-5-5)
ASISTENTE_MODELO=
