# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Llave pública: "anon" o la nueva "publishable" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Llave privada del servidor: "service_role" o la nueva "secret" (sb_secret_...). NUNCA en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Cadena de conexión a Postgres (Project Settings → Database → Connection string, "Session pooler").
# Solo se usa para correr migraciones con `npm run db:migrate`.
DATABASE_URL=

# URL pública de la app (para generar los enlaces de invitación)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secreto de un solo uso para crear el primer administrador (POST /api/setup)
SETUP_SECRET=cambia-esto-por-algo-largo
